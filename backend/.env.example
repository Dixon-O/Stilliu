# ── Stilliu backend — environment variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# watsonx.ai credentials (required)
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://eu-gb.ml.cloud.ibm.com

# ── Model IDs ────────────────────────────────────────────────────────────────
# These are *requests*, not requirements. Model availability differs per region,
# so on startup Stilliu asks watsonx what this account can actually call and
# resolves each role against that list (backend/app/services/model_registry.py).
# An id set here is tried first; if the region does not host it, the next
# preference is used and the substitution is logged. Leave them unset to let the
# registry choose entirely on its own.

# Creative rewrites — wants the strongest instruction-following model available.
GENERATION_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# The "bland AI default" that Distinctiveness is measured against. Deliberately a
# Granite model from a *different provider family* than the creative model, so
# the anchor is an independent idea of generic prose rather than a colder run of
# the model being scored.
BASELINE_MODEL_ID=ibm/granite-4-h-small

# All distance measurement — voice match, distinctiveness, on-message.
EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# Demo mode — set to true to serve pre-computed fixture responses (no API calls)
# Useful for offline testing and the live demo safety net.
DEMO_MODE=false

# Timeouts (seconds)
# SCORE_TIMEOUT covers embed + 1 generation (~12s warm, ~28s cold on eu-gb)
# ANALYZE_TIMEOUT covers score + 3 parallel persona generations (~20s warm)
SCORE_TIMEOUT=60
ANALYZE_TIMEOUT=120

# ── Stilliu backend — environment variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# watsonx.ai credentials (required)
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://eu-gb.ml.cloud.ibm.com

# Model IDs (defaults are fine — only change if you want to experiment)
GENERATION_MODEL_ID=ibm/granite-3-8b-instruct
EMBEDDING_MODEL_ID=ibm/granite-embedding-125m-english

# Demo mode — set to true to serve pre-computed fixture responses (no API calls)
# Useful for offline testing and the live demo safety net.
DEMO_MODE=false

# Timeout for watsonx.ai API calls in seconds (default 8)
WATSONX_TIMEOUT=8
